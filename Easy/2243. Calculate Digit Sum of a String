class Solution {
    public String digitSum(String s, int k) {
        int n = s.length();
        StringBuilder st  = new StringBuilder();
        int i = 0;
        while(s.length() > k){
            int sum = 0;
            String temp = s.substring(i, Math.min(i+k, n));
            for(int j = 0; j < temp.length(); j++ ){
                sum += (temp.charAt(j) - '0');
            }
            st.append(sum);
            i += k;
            if(i >= n){
                i = 0;
                s = st.toString();
                n = s.length();
                st = new StringBuilder();
            }
        }
        return s;
    }
}
