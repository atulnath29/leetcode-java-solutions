class Solution {
    int n;
    public int maxPalindromes(String s, int k) {
        n=s.length();
        if(k==1)return n;
        int[][]arr=new int[n+1][n+1];
        for(int[]row:arr) Arrays.fill(row,-1);
        return helper(s,k,0,k-1,arr);
    }
    public int helper(String s,int k,int i,int j,int[][]dp){
        if(i>=n||j>=n)return 0;
        if(dp[i][j]!=-1)return dp[i][j];
        if(isPalindrome(s,i,j)){
            int take=1+helper(s,k,j+1,j+k,dp);
            int dontTakeGrow=helper(s,k,i,j+1,dp);
            int ignoreCurIndex=helper(s,k,i+1,j+1,dp);
            return dp[i][j]=Math.max(take,Math.max(dontTakeGrow,ignoreCurIndex));
        }
        int grow=helper(s,k,i,j+1,dp);
        int ignoreCurIndex=helper(s,k,i+1,j+1,dp);
        return dp[i][j]=Math.max(grow,ignoreCurIndex);
    }
    public boolean isPalindrome(String s,int start,int end){
        while(start<end){
            if(s.charAt(start)!=s.charAt(end))return false;
            start++;
            end--;
        }
        return true;
    }
}
