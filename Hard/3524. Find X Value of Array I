class Solution {
    public long[] resultArray(int[] nums, int k) {
        int n = nums.length;
        long[] ans = new long[k];
        for (int i = 0; i < n; i++) {
            nums[i] %= k;
        }
        for (int i = 0; i < k; i++) {
            long[][] dp = new long[n][k + 1];
            for (int j = 0; j < n; j++) {
                Arrays.fill(dp[j], -1);
            }
            for (int j = 0; j < n; j++) {
                ans[i] += solve (j, 1, k, dp, nums, i);
            }
        }
        return ans;
    }
    public static long solve(int i, int num, int k, long[][] dp, int[] nums, int u) {
        if (i >= nums.length) {
            return 0;
        }
        num = (num * nums[i]) % k;
        if (dp[i][num] != -1) {
            return dp[i][num];
        }
        long ans = (num == u ? 1 : 0) + solve(i + 1, num, k, dp, nums, u);
        return dp[i][num] = ans;
    }
}
