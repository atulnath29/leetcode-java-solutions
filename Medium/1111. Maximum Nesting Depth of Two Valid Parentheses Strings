import java.util.Stack;
class Solution {
    public int[] maxDepthAfterSplit(String seq) {
        Stack<Character> stack = new Stack<>();
        int [] result = new int[seq.length()];
        int i= 0, curr=0;
        for (Character c : seq.toCharArray()){
            if(c.equals('(')){
                curr = stack.size()%2;
                result[i++] = curr;
                stack.push(c);
                
            }
            else{
                result[i++] = stack.size()%2==0?1:0;
                stack.pop();
                
            }
        }
        return result;
    }
}
