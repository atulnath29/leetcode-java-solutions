class Solution {
    public int numOfSubarrays(int[] arr) {
        int res = 0;
        int currSum = 0;
        int even = 0;
        int odd = 0;

        for(int x : arr){
            currSum += x;

            if(currSum % 2 != 0){
                odd = odd + 1;
                res = (res + 1 + even) % 1000000007;
            }else{
                res = (res + odd) % 1000000007;
                even += 1;
            }
        }

        res = res % 1000000007;

        return res;
    }
}
