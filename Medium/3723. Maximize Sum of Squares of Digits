public class Solution {
    public String maxSumOfSquares(int num, int sum) {
        int n9 = sum / 9;
        int rem = sum % 9;
        int requiredDigits = n9 + (rem > 0 ? 1 : 0);
        if (requiredDigits > num) {
            return "";
        }
        char[] result = new char[num];
        int idx = 0;
        for (int i = 0; i < n9; i++) {
            result[idx++] = '9';
        }
        if (rem > 0) {
            result[idx++] = (char) ('0' + rem);
        }
        while (idx < num) {
            result[idx++] = '0';
        }
        return new String(result);
    }
}
