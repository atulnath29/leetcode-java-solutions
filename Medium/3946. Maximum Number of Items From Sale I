class Solution {
    int[][] dp;
    int minPrice = Integer.MAX_VALUE;
    public int dp(int i,int budget,int[][] items,int[] f){
        if (i < 0) {
        return budget / minPrice;
    }
        if(dp[i][budget]!=-1) return dp[i][budget];
        int p = items[i][1];
        int take = 0;
        if(budget>=p){
            take = 1+f[i] + dp(i-1,budget-p,items,f);
        }
        int not = dp(i-1,budget,items,f);
        return dp[i][budget] = Math.max(take,not);
    }
    public int maximumSaleItems(int[][] items, int budget) {
        int n = items.length;
        int[] factors = new int[n];
        dp = new int[n][budget+1];
        for(int[] row:dp){
            Arrays.fill(row,-1);
        } 
        for(int i=0;i<n;i++){
            int fi = items[i][0];
            minPrice = Math.min(minPrice,items[i][1]);
            for(int j=0;j<n;j++){
                if(j!=i){
                    int fj = items[j][0];
                    if(fj%fi==0){
                        factors[i]++;
                    }
                }
            }
        }
        return dp(n-1,budget,items,factors);
    }
}
